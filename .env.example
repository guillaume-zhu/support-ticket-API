DATABASE_URL="postgresql://YOUR_USER@127.0.0.1:5433/support_ticket"
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
TRUST_PROXY=0

# Assistant IA : laisser AI_PROVIDER, AI_API_KEY et AI_MODEL vides désactive l'assistant (POST /ai/chat répond 503).
# AI_PROVIDER : openai ou deepseek. AI_MODEL : nom exact d'un modèle autorisé par ta clé.
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
# Optionnels : adresse https du fournisseur (ex. région UE d'OpenAI), plafond de tokens de la réponse
# (raisonnement compris), délai en millisecondes, et effort de raisonnement (none, low, medium, high).
# AI_BASE_URL=
# AI_MAX_OUTPUT_TOKENS=2000
# AI_TIMEOUT_MS=30000
# AI_REASONING_EFFORT=none
# AI_TICKET_TOOLS=true autorise l'assistant à consulter les tickets que l'utilisateur a le droit de voir :
# leur titre et leur description sont alors envoyés au fournisseur. Désactivé par défaut (false).
# AI_TICKET_TOOLS=false
# Les conversations avec l'assistant sont enregistrées en base. Une tâche planifiée (npm run ai:purge-conversations)
# supprime celles sans activité depuis plus de ce nombre de jours (90 par défaut).
# AI_CONVERSATION_RETENTION_DAYS=90

# Documentation (Swagger UI) : true ou false. Par défaut : activée sauf en production.
# API_DOCS=true
